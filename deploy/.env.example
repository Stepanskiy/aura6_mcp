# Скопіювати в .env і заповнити. Файл .env у git не потрапляє.

# Домени: A-записи мають вказувати на IP VPS
AUTH_DOMAIN=auth.example.com
MCP_DOMAIN=mcp.example.com

# Пошта для Let's Encrypt (сповіщення про сертифікати)
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-me-long-random

# Адміністратор Keycloak (тільки для першого запуску)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-long-random
